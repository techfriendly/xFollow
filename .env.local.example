# App
APP_ENV=local
APP_DEFAULT_LOCALE=es
APP_SUPPORTED_LOCALES=es,ca
NEXT_PUBLIC_XFOLLOW_API_BASE_URL=http://localhost:8101
XFOLLOW_WEB_PORT=3101
XFOLLOW_API_PORT=8101

# Existing xTender/ProcureAI PostgreSQL. xFollow only creates schema xfollow.
POSTGRES_DSN=postgresql://procureai:procureai@127.0.0.1:55432/procureai
# ProcureAI publishes PostgreSQL on loopback, so containers use its shared Docker network.
POSTGRES_DSN_DOCKER=postgresql://procureai:procureai@procureai-postgres-1:5432/procureai
XFOLLOW_POSTGRES_NETWORK=procureai_default
XFOLLOW_DB_REQUIRED=1
XFOLLOW_DB_CONNECT_TIMEOUT=3
XFOLLOW_INTEGRATIONS_ENABLED=1
OBJECT_STORAGE_ENDPOINT=http://host.docker.internal:8333
OBJECT_STORAGE_BUCKET=procureai
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=eu-west-1

# LLM compatible with the existing ProcureAI configuration
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=
LLM_MODEL=your-served-model
LLM_CONTEXT_WINDOW=128000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=300
XFOLLOW_AI_WORKER_POLL_SECONDS=3
XFOLLOW_AI_RETRY_MAX_SECONDS=300
XFOLLOW_AI_SOURCE_MAX_CHARS=12000
XFOLLOW_AI_SOURCE_TOTAL_CHARS=60000
XFOLLOW_UPLOAD_MAX_BYTES=26214400

# Security
AUTH_MODE=development_headers
API_AUTH_BEARER_TOKEN=
CORS_ORIGINS=http://localhost:3101,http://127.0.0.1:3101

# Tests/local fallback
XFOLLOW_FORCE_MEMORY=0
